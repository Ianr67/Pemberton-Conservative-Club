# Copy this file to .env and replace the password before starting PostgreSQL.
POSTGRES_DB=pcc_development
POSTGRES_USER=pcc_development
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5433

# Keep this URL in sync with the values above. URL-encode special password characters.
DATABASE_URL=postgresql://pcc_development:replace-with-a-local-development-password@localhost:5433/pcc_development

