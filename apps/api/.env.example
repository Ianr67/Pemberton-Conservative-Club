NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://pcc_development:replace-with-a-local-development-password@localhost:5433/pcc_development
PUBLIC_API_URL=http://localhost:3002/api/v1
# Use filesystem for local development. Production must explicitly use s3.
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_STORAGE_PATH=.media

# Production S3-compatible adapter (never commit real credentials):
# MEDIA_STORAGE_DRIVER=s3
# S3_ENDPOINT=https://objects.example.test
# S3_REGION=auto
# S3_BUCKET=pcc-media
# S3_ACCESS_KEY_ID=replace-with-provider-access-key
# S3_SECRET_ACCESS_KEY=replace-with-provider-secret-key
# S3_FORCE_PATH_STYLE=false
